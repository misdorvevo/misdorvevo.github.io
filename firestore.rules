rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True only when the write changes nothing but `likes`, by adding or removing exactly the caller's own uid.
    function togglesOwnLike() {
      let before = resource.data.get('likes', []).toSet();
      let after = request.resource.data.likes.toSet();
      let me = [request.auth.uid].toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && ((after.difference(before) == me && before.difference(after).size() == 0)
            || (before.difference(after) == me && after.difference(before).size() == 0));
    }

    // Public profile: anyone can read, only the owner can write.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'bio', 'photoURL', 'photoPath', 'links', 'updatedAt', 'licenseAcceptedAt', 'licenseVersion'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
        && (request.resource.data.photoPath == null || request.resource.data.photoPath.matches('avatars/' + uid + '/.*'))
        && request.resource.data.links is list
        && request.resource.data.links.size() <= 6;
      allow delete: if false;
    }

    // Direct messages: conversations/{uidA_uidB} (uids sorted) with a `messages` subcollection.
    // Only the two participants can read or write.
    match /conversations/{convId} {
      function isParticipant(data) {
        return request.auth != null && request.auth.uid in data.participants;
      }

      allow read: if isParticipant(resource.data);

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['participants', 'lastMessage', 'lastSenderUid', 'updatedAt', 'readAt'])
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && convId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 100
        && request.resource.data.updatedAt == request.time
        && request.resource.data.readAt.keys().hasOnly([request.auth.uid]);

      // Participants can post a new last message (as themselves) or update only their own read marker.
      allow update: if isParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt', 'readAt'])
        && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([request.auth.uid])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'lastSenderUid', 'updatedAt'])
            || (request.resource.data.lastSenderUid == request.auth.uid
                && request.resource.data.lastMessage is string
                && request.resource.data.lastMessage.size() <= 100
                && request.resource.data.updatedAt == request.time));

      allow delete: if false;

      match /messages/{messageId} {
        // Based on the id (uidA_uidB) so a listener can attach before the conversation document exists.
        allow read: if request.auth != null && request.auth.uid in convId.split('_');

        // getAfter lets the first message be created in the same batch as its conversation.
        allow create: if isParticipant(getAfter(/databases/$(database)/documents/conversations/$(convId)).data)
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // Weekly challenge: submissions are only accepted during the week they belong to
    // (weeks start Monday 00:00 UTC, matching weekIndexAt() in src/lib/challenges.ts); older weeks are a read-only archive.
    function isModerator() {
      return request.auth != null && request.auth.uid in ['IrMD02tuYubDSXSrdFXJg7TWxwX2'];
    }

    // Per-week overrides (title, prompt, pack, winner) are moderator-only.
    match /challenges/{weekIndex} {
      allow read: if true;
      allow write: if isModerator()
        && request.resource.data.keys().hasOnly(['title', 'prompt', 'packId', 'winnerId', 'updatedAt'])
        && request.resource.data.title.size() <= 80
        && request.resource.data.prompt.size() <= 300;
    }

    match /challenges/{weekIndex}/submissions/{submissionId} {
      allow read: if true;

      allow create: if request.auth != null
        && weekIndex == string(math.floor((request.time.toMillis() + 259200000) / 604800000))
        && request.resource.data.keys().hasOnly(['title', 'description', 'audioUrl', 'storagePath', 'packId', 'packName', 'authorUid', 'authorName', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.audioUrl is string
        && request.resource.data.packId is string
        && request.resource.data.packName is string
        && request.resource.data.storagePath.matches('songs/' + request.auth.uid + '/.*')
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if request.auth != null && (resource.data.authorUid == request.auth.uid || isModerator());
    }

    match /samplePacks/{packId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.likes == [];

      // Owners can edit their pack. Anyone signed in can only add/remove their own uid in `likes`.
      // togglesOwnLike() only allows `likes` to change, so it needs no uploader check (and works on legacy packs without uploaderUid).
      allow update: if request.auth != null
        && (togglesOwnLike()
            || (resource.data.uploaderUid == request.auth.uid
                && request.resource.data.uploaderUid == resource.data.uploaderUid));

      allow delete: if request.auth != null && resource.data.uploaderUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.likes == []
          && request.resource.data.createdAt == request.time;

        allow update: if request.auth != null
          && togglesOwnLike();

        // Authors delete their own comments; a parent's author may delete its replies (cascade delete).
        allow delete: if request.auth != null
          && (resource.data.authorUid == request.auth.uid
              || (resource.data.parentId != null
                  && get(/databases/$(database)/documents/samplePacks/$(packId)/comments/$(resource.data.parentId)).data.authorUid == request.auth.uid));
      }

      match /songs/{songId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['title', 'description', 'audioUrl', 'storagePath', 'authorUid', 'authorName', 'likes', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.audioUrl is string
          && request.resource.data.storagePath.matches('songs/' + request.auth.uid + '/.*')
          && request.resource.data.likes == []
          && request.resource.data.createdAt == request.time;

        // Songs can't be edited; signed-in users may only add/remove their own uid in `likes`.
        allow update: if request.auth != null
          && togglesOwnLike();

        allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;

        match /comments/{commentId} {
          allow read: if true;

          allow create: if request.auth != null
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && request.resource.data.likes == []
            && request.resource.data.createdAt == request.time;

          allow update: if request.auth != null
            && togglesOwnLike();

          // Comment authors, the song's owner (moderation / song deletion) and a parent comment's author can delete.
          allow delete: if request.auth != null
            && (resource.data.authorUid == request.auth.uid
                || get(/databases/$(database)/documents/samplePacks/$(packId)/songs/$(songId)).data.authorUid == request.auth.uid
                || (resource.data.parentId != null
                    && get(/databases/$(database)/documents/samplePacks/$(packId)/songs/$(songId)/comments/$(resource.data.parentId)).data.authorUid == request.auth.uid));
        }
      }
    }
  }
}
